  m_Script: {fileID: 11500000, guid: 5b63f36237e571642bea2628248c4ca5, type: 3}
  m_Name: Boss_1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueText
  <Dialogue>k__BackingField:
  - text: Mr Doe, welcome. Please have a seat!
    dialogueType: 4
    isRespondableText: 1
    successResponse: Of course, sir.
    failureResponse: "\u2026"
  - text: "I\u2019m sure you wonder why you are here. Well, it really doesn\u2019t
      matter because I will tell you anyway."
    dialogueType: 5
    isRespondableText: 0
    successResponse: 
    failureResponse: 
  - text: You fuck up, Doe. You really fuck it up this time!
    dialogueType: 6
    isRespondableText: 1
    successResponse: Excuse me, sir?
    failureResponse: "\u2026What?"
  - text: Listen here, I thought you were my best employee. I expected better from
      you.
    dialogueType: 7
    isRespondableText: 0
    successResponse: 
    failureResponse: 
  - text: The deal fell through because of your incompetence.. You fail me, you fail
      your co-workers, you fail this company.
    dialogueType: 5
    isRespondableText: 1
    successResponse: "Sir, it is not my fault. I didn\u2019t have enough time."
    failureResponse: "\u2026How is that my fault, if you can\u2019t give me enough
      time?"
  - text: Get out and reflect on your issue.
    dialogueType: 0
    isRespondableText: 0
    successResponse: 
    failureResponse: 
